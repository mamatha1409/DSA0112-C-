//online shopping system


#include <iostream>
#include <vector>
#include <string>

using namespace std;

class Item {
public:
    string name;
    float price;

    Item(string n, float p) : name(n), price(p) {}
};

class ShoppingCart {
public:
    vector<Item> cart;

    void addItem(const Item& item) {
        cart.push_back(item);
        cout << item.name << " added to cart." << endl;
    }

    void displayCart() {
        if (cart.empty()) {
            cout << "Your cart is empty." << endl;
            return;
        }

        cout << "Items in your cart:" << endl;
        for (const auto& item : cart) {
            cout << "- " << item.name << ": $" << item.price << endl;
        }
    }

    float checkout() {
        float total = 0;
        for (const auto& item : cart) {
            total += item.price;
        }
        cart.clear(); 
        return total;
    }
};

int main() {
    vector<Item> items = {
        Item("Laptop", 999.99),
        Item("Smartphone", 599.99),
        Item("Headphones", 199.99),
        Item("Smartwatch", 299.99)
    };

    ShoppingCart cart;
    int choice;

    do {
        // Display available items
        cout << "\nAvailable items:" << endl;
        for (size_t i = 0; i < items.size(); i++) {
            cout << i + 1 << ". " << items[i].name << ": $" << items[i].price << endl;
        }

        cout << "Enter item number to add to cart (0 to checkout, -1 to exit): ";
        cin >> choice;

        if (choice > 0 && choice <= items.size()) {
            cart.addItem(items[choice - 1]);
        } else if (choice == 0) {
            cart.displayCart();
            float total = cart.checkout();
            cout << "Total: $" << total << endl;
            cout << "Thank you for shopping!" << endl;
        } else if (choice == -1) {
            cout << "Exiting..." << endl;
        } else {
            cout << "Invalid choice. Try again." << endl;
        }

    } while (choice != -1);

    return 0;
}



