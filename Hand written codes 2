//sum of non adjacent 

#include <iostream>
using namespace std;

int maxNonAdjacentSum(int arr[], int n) {
    int include = 0;
    int exclude = 0;

    for (int i = 0; i < n; i++) {
        int num = arr[i];
        int newExclude = max(include, exclude);
        include = exclude + num;
        exclude = newExclude;
    }

    return max(include, exclude);
}

int main() {
    int arr[] = {3, 2, 5, 10, 7};
    int n = sizeof(arr) / sizeof(arr[0]);

    int maxSum = maxNonAdjacentSum(arr, n);
    cout << "Maximum sum of non-adjacent elements: " << maxSum << endl;

    return 0;
}
