
//medium sorted array

#include<iostream>
using namespace std;
class number{
	public:
		int m,n;
		number(int start,int end):m(start),n(end){}
};
class skipper:public number{
public:
	int k;
	skipper(int start,int end,int skip):number(start,end),k(skip){}
	void print(){
		for(int i=m;i<=n;i+=(k+1)){
			cout<<i<<" ";
		}
		cout<<endl;
	}
};
int main(){
	int m=40,n=100,k=5;
	skipper obj(m,n,k);
	obj.print();
	return 0;
}



