int main() {
    int size;
    cout << "Enter size for pyramid: ";
    cin >> size;
    for (int i = 1; i <= size; i++) {
        for (int j = 1; j <= size - i; j++) cout << " ";
        for (int j = 1; j <= 2 * i - 1; j++)
            cout << (j == 1 || j == 2 * i - 1 || i == size ? "*" : " ");
        cout << endl;
    }
    cout << "\nEnter size for square: ";
    cin >> size;
    for (int i = 1; i <= size; i++) {
        for (int j = 1; j <= size; j++)
