//To find all qudratriplets in an array
#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

void findQuadruplets(int arr[], int n, int target) {
    sort(arr, arr + n); 

    for (int i = 0; i < n - 3; i++) {
        if (i > 0 && arr[i] == arr[i - 1]) continue; 

        for (int j = i + 1; j < n - 2; j++) {
            if (j > i + 1 && arr[j] == arr[j - 1]) continue; 

            int left = j + 1;
            int right = n - 1;

            while (left < right) {
                int sum = arr[i] + arr[j] + arr[left] + arr[right];

                if (sum == target) {
                    cout << "[" << arr[i] << ", " << arr[j] << ", " << arr[left] << ", " << arr[right] << "]\n";

                    while (left < right && arr[left] == arr[left + 1]) left++;
                    while (left < right && arr[right] == arr[right - 1]) right--;

                    left++;
                    right--;
                } else if (sum < target) {
                    left++;
                } else {
                    right--;
                }
            }
        }
    }
}

int main() {
    int arr[] = {1, 0, -1, 0, -2, 2};
    int n = sizeof(arr) / sizeof(arr[0]);
    int target = 0;

    cout << "Unique quadruplets that sum to " << target << ":\n";
    findQuadruplets(arr, n, target);

    return 0;
}

//power using overloading//
#include <iostream>
using namespace std;

int power(int base, int exp) {
    int result = 1;
    for (int i = 0; i < exp; i++) result *= base;
    return result;
}

double power(double base, int exp) {
    double result = 1;
    for (int i = 0; i < exp; i++) result *= base;
    return result;
}

int main() {
    cout << "2^3 = " << power(2, 3) << endl;
    cout << "2.5^3 = " << power(2.5, 3) << endl;
    return 0;
}

