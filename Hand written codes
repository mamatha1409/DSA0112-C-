//Encoding//
#include <iostream>
#include <string>
using namespace std;

string encode(const string &input, int key) {
    string encoded = "";
    for (char ch : input) {
        if (isalpha(ch)) {
            char base = islower(ch) ? 'a' : 'A';
            encoded += (ch - base + key) % 26 + base;
        } else {
            encoded += ch;
        }
    }
    return encoded;
}

string decode(const string &input, int key) {
    return encode(input, 26 - key);
}

int main() {
    string text;
    int key;

    cout << "Enter a string to encode: ";
    getline(cin, text);
    cout << "Enter key: ";
    cin >> key;

    string encodedText = encode(text, key);
    cout << "Encoded: " << encodedText << endl;

    string decodedText = decode(encodedText, key);
    cout << "Decoded: " << decodedText << endl;

    return 0;
}

//Prefix//
#include <iostream>
#include <vector>
using namespace std;
string longestCommonPrefix(vector<string>& strs) {
    if (strs.empty()) return "";
    string prefix = strs[0];
    for (int i = 1; i < strs.size(); ++i) {
        while (strs[i].find(prefix) != 0) 
            prefix.pop_back(); 
        if (prefix.empty()) return "";
    }
    return prefix;
}
int main() {
    vector<string> strs = {"flower", "flow", "flight"};
    cout << longestCommonPrefix(strs) << endl;
    return 0;
}

//co,mpress//
#include <iostream>
#include <string>
using namespace std;
string compressString(const string &input) {
    string compressed = "";
    for (size_t i = 0; i < input.size(); ++i) {
        int count = 1;
        while (i < input.size() - 1 && input[i] == input[i + 1]) {
            count++;
            i++;
        }
        compressed += input[i]; 
        if (count > 1) compressed += to_string(count);
    }
    return compressed.size() < input.size() ? compressed : input;
}
int main() {
    cout << compressString("aabbbccccccd") << endl;
    return 0;
}
//Tower of hanoi//
#include <iostream>
using namespace std;
void towerOfHanoi(int n, char source, char target, char auxiliary) {
    if (n == 1) {
        cout << "Move disk 1 from " << source << " to " << target << endl;
        return;
    }
    towerOfHanoi(n - 1, source, auxiliary, target);
    cout << "Move disk " << n << " from " << source << " to " << target << endl;
    towerOfHanoi(n - 1, auxiliary, target, source);
}
int main() {
    int n = 3;
    towerOfHanoi(n, 'A', 'C', 'B');
    return 0;
}

