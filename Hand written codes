//reverse function to remove duplicates//
#include <iostream>
using namespace std;
string removeDuplicates(string s) {
    if (s.length() <= 1) {
        return s;
    }
    if (s[0] == s[1]) {
        return removeDuplicates(s.substr(1));
    }
    return s[0] + removeDuplicates(s.substr(1));
}
int main() {
    string input;
    cout << "Enter a string: ";
    cin >> input;
    string result = removeDuplicates(input);
    cout << "String after removing duplicates: " << result << endl;    
    return 0;
}

//subsequences//
#include <iostream>
using namespace std;
void generateSubsequences(string s, string current, int index) {
    if (index == s.length()) {
        cout << current << endl;
        return;
    }
    generateSubsequences(s, current + s[index], index + 1);
    generateSubsequences(s, current, index + 1);
}
int main() {
    string input;
    cout << "Enter a string: ";
    cin >> input;
    cout << "Subsequences of the string are:\n";
    generateSubsequences(input, "", 0);
    return 0;
}

//permutations and combinations//
#include <iostream>
using namespace std;
int factorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}
int permutations(int n, int r) {
    return factorial(n) / factorial(n - r);
}
int combinations(int n, int r) {
    return factorial(n) / (factorial(r) * factorial(n - r));
}
int main() {
    int n, r;
    cout << "Enter values for n and r (n >= r): ";
    cin >> n >> r;
    if (n < r) {
        cout << "Invalid input! n must be greater than or equal to r." << endl;
        return 1;
    }
    int perm = permutations(n, r);
    int comb = combinations(n, r);
    cout << "Permutations (nPr): " << perm << endl;
    cout << "Combinations (nCr): " << comb << endl;
    return 0;
}

//Type converstion exception//
#include <iostream>
#include <stdexcept>
using namespace std; 
class Base {
public:
    virtual ~Base() {}
};
class Derived : public Base {
public:
    void show() {
        cout << "Derived class show function." << endl;
    }
};
class Unrelated {}; 
void safeCast(Base* basePtr) {
    Derived* derivedPtr = dynamic_cast<Derived*>(basePtr);
    if (derivedPtr) {
        derivedPtr->show();
    } else {
        throw runtime_error("Type conversion failed: basePtr is not pointing to a Derived object.");
    }
}
int main() {
    Base* basePtr = new Base(); 
    Derived* derivedPtr = new Derived(); 
    try {
        safeCast(basePtr); 
    } catch (const runtime_error& e) {
        cerr << "Exception caught: " << e.what() << endl;
    }
    try {
        safeCast(derivedPtr);
    } catch (const runtime_error& e) {
        cerr << "Exception caught: " << e.what() << endl;
    }
    delete basePtr; 
    delete derivedPtr;
    return 0;
}

//Magic number//
#include <iostream>
using namespace std;1
int digitalRoot(int n) {
    while (n >= 10) { 
        int sum = 0;
        while (n > 0) {
            sum += n % 10;
            n /= 10;      
        }
        n = sum; 
    }
    return n; 
}
int main() {
    int number;
    cout << "Enter a number: ";
    cin >> number;
    int result = digitalRoot(number);
    if (result == 1) {
        cout << number << " is a magic number!" << endl;
    } else {
        cout << number << " is not a magic number." << endl;
    }
    return 0;
}

